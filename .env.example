# Chat Harness environment configuration

# Database: SQLite for local dev, PostgreSQL+pgvector for production
DATABASE_URL=sqlite+aiosqlite:///./data/chat_harness.db
# DATABASE_URL=postgresql+asyncpg://chatharness:chatharness@127.0.0.1:5432/chatharness

# Podman control
MOCK_PODMAN=true
PODMAN_BINARY=podman
CHAT_CONTAINER_IMAGE=localhost/chat-harness-agent:latest
CHAT_BASE_DIR=./data/chats
INACTIVITY_TIMEOUT_SECONDS=1800
SNAPSHOT_INTERVAL_SECONDS=60

# Agents
DEVIN_DEFAULT_MODEL=glm-5.2-high
AGY_ACP_COMMAND=npx -y agy-acp
# GENERIC_ACP_COMMAND=python -m my_acp_server

# Embeddings (optional: pip install -e .[embeddings])
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
PGVECTOR_DIM=768

# Secrets - set the ones you need for each agent
WINDSURF_API_KEY=
AGY_API_KEY=
ACP_API_KEY=

# Secrets vault: none, age, or sops
SECRETS_VAULT=none
AGE_KEY_PATH=./data/secrets/age.key
SECRETS_FILE=./data/secrets/secrets.enc.yaml

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
