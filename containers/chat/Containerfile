# syntax=docker/dockerfile:1
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/chat
ENV USER=chat
ENV PATH=/home/chat/.local/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    socat \
    bubblewrap \
    podman \
    buildah \
    fuse-overlayfs \
    slirp4netns \
    uidmap \
    newuidmap \
    newgidmap \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    chromium-browser \
    chromium-chromedriver \
    firefox \
    libnss3 \
    libgtk-3-0 \
    libgbm-dev \
    libasound2 \
    fonts-liberation \
    libu2f-udev \
    && rm -rf /var/lib/apt/lists/*

# Create chat user with fixed UID/GID 1000/1000 for rootless Podman.
RUN groupadd -g 1000 chat && useradd -m -u 1000 -g chat chat
RUN echo "chat:100000:65536" > /etc/subuid && \
    echo "chat:100000:65536" > /etc/subgid

USER chat
WORKDIR /home/chat

# Install Devin CLI.
RUN curl -fsSL https://cli.devin.ai/install.sh | bash

# Install AGY ACP adapter.
RUN npm config set prefix /home/chat/.local && \
    npm install -g agy-acp

# Install Playwright for the agent and browsers.
RUN python3 -m pip install --user --break-system-packages \
    playwright \
    requests
RUN python3 -m playwright install chromium

# Configure rootless Podman inside the container.
RUN mkdir -p /home/chat/.config/containers /home/chat/.local/share/containers
COPY storage.conf /home/chat/.config/containers/storage.conf
COPY registries.conf /home/chat/.config/containers/registries.conf
COPY libpod.conf /home/chat/.config/containers/libpod.conf

# VNC + noVNC runtime script.
COPY entrypoint.sh /home/chat/entrypoint.sh
RUN chmod +x /home/chat/entrypoint.sh

EXPOSE 6080

ENTRYPOINT ["/home/chat/entrypoint.sh"]
