# syntax=docker/dockerfile:1
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/chat
ENV USER=chat
ENV PATH=/home/chat/.local/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openssh-client \
    gnupg \
    age \
    wget \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    socat \
    bubblewrap \
    podman \
    buildah \
    skopeo \
    fuse-overlayfs \
    slirp4netns \
    uidmap \
    dbus \
    dbus-x11 \
    openbox \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    firefox \
    libnss3 \
    libgtk-3-0 \
    libgbm-dev \
    libasound2t64 \
    fonts-liberation \
    libu2f-udev \
    && rm -rf /var/lib/apt/lists/*

# Create chat user for rootless Podman (use next available UID/GID).
RUN groupadd chat && useradd -m -g chat chat
RUN echo "chat:100000:65536" > /etc/subuid && \
    echo "chat:100000:65536" > /etc/subgid

USER chat
WORKDIR /home/chat

# Make sure ~/.local/bin and ~/.local/lib exist for the chat user.
RUN mkdir -p /home/chat/.local/bin /home/chat/.local/lib /home/chat/.local/share/containers

# Install Devin CLI (interactive installer, but works non-interactively when run with bash).
RUN curl -fsSL https://cli.devin.ai/install.sh | bash

# Install AGY ACP adapter.
RUN npm config set prefix /home/chat/.local && \
    npm install -g agy-acp

# Install Playwright and its Chromium browser for automated browser tests.
RUN python3 -m pip install --user --break-system-packages \
    playwright \
    requests
RUN python3 -m playwright install chromium

# Configure rootless Podman inside the container (VFS driver by default).
RUN mkdir -p /home/chat/.config/containers
COPY --chown=chat:chat storage.conf /home/chat/.config/containers/storage.conf
COPY --chown=chat:chat registries.conf /home/chat/.config/containers/registries.conf
COPY --chown=chat:chat containers.conf /home/chat/.config/containers/containers.conf

# VNC + noVNC runtime script.
COPY --chown=chat:chat entrypoint.sh /home/chat/entrypoint.sh
RUN chmod +x /home/chat/entrypoint.sh

EXPOSE 6080

ENTRYPOINT ["/home/chat/entrypoint.sh"]
